      "required": [
        "id",
        "matter_id",
        "scope",
        "episode_ids",
        "source_id",
        "source_order_id",
        "event_date",
        "publication",
        "status",
        "locator",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "selection_event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "matter_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_key": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "included",
            "excluded",
            "pending"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "matter_id",
        "candidate_key",
        "decision",
        "reason",
        "frame_sha256",
        "recorded_at"
      ],
      "additionalProperties": false
    }
