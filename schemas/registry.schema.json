{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sebi:registry:0.1",
  "title": "Normalized registry draft 0.1",
  "description": "Shape contract, not a domain-validity or evidence-truth certificate. Raw rejected rows remain in import diagnostics.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "dataset_kind": {
      "enum": [
        "synthetic",
        "research"
      ]
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "authored_at": {
      "type": "string",
      "format": "date-time"
    },
    "selected_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "matters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/matter"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "label_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label_version"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "legal_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legal_event"
      }
    },
    "selection_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selection_event"
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_kind",
    "release_id",
    "authored_at",
    "selected_claim_ids",
    "reviewers",
    "matters",
    "episodes",
    "label_versions",
    "claims",
    "sources",
    "orders",
    "evidence",
    "reviews",
    "legal_events",
    "selection_events"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "date"
            },
            "data": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "data": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "verified"
            },
            "precision": {
              "const": "timestamp"
            },
            "value": {
              "type": "string",
              "format": "date-time"
            },
            "basis_source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "basis",
            "precision",
            "value",
            "basis_source_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "verified"
            },
            "precision": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            },
            "basis_source_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "basis",
            "precision",
            "value",
            "basis_source_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "assumed"
            },
            "precision": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            },
            "basis_source_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "basis",
            "precision",
            "value",
            "basis_source_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "unknown"
            },
            "precision": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            },
            "basis_source_id": {
              "type": "null"
            }
          },
          "required": [
            "basis",
            "precision",
            "value",
            "basis_source_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pdf_page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "page",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "table_key"
            },
            "key": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "column",
                "value"
              ],
              "additionalProperties": false
            },
            "column": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "key",
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "fixture_line"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "line"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "automation"
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "kind"
      ],
      "additionalProperties": false
    },
    "matter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "independence_group_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_state": {
          "enum": [
            "pending",
            "first_pass",
            "audited",
            "finalized_unresolved",
            "excluded"
          ]
        },
        "inventory_state": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "legal_history_state": {
          "enum": [
            "pending",
            "checked",
            "unknown"
          ]
        },
        "legal_checked_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "independence_group_id",
        "review_state",
        "inventory_state",
        "legal_history_state",
        "legal_checked_on"
      ],
      "additionalProperties": false
    },
    "episode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "matter_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "first_disclosure_evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observability": {
          "enum": [
            "pending",
            "daily",
            "intraday",
            "participant",
            "indeterminate"
          ]
        },
        "observability_recorded_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "matter_id",
        "first_disclosure_evidence_id",
        "observability",
        "observability_recorded_at"
      ],
      "additionalProperties": false
    },
    "label_version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_kind": {
          "enum": [
            "initial",
            "new_public_fact",
            "extraction_correction"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "change_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "episode_id",
        "version_no",
        "supersedes_id",
        "change_kind",
        "recorded_at",
        "change_note"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "subject_type": {
          "enum": [
            "matter",
            "episode",
            "label_version"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "field": {
          "enum": [
            "conduct_start",
            "conduct_end",
            "alleged_scheme",
            "instrument",
            "isin",
            "legal_status",
            "order_date"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "change_kind": {
          "enum": [
            "initial",
            "extraction_correction"
          ]
        },
        "change_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "field",
        "value",
        "revision",
        "supersedes_id",
        "recorded_at",
        "change_kind",
        "change_note"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "order_pdf",
            "table_csv",
            "fixture_text"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "publication": {
          "$ref": "#/$defs/publication"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "local_path",
        "sha256",
        "page_count",
        "publication",
        "retrieved_at"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "matter_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "order_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "matter_id",
        "source_id",
        "order_date"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "order_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "extracted_value": {
          "$ref": "#/$defs/value"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "claim_id",
        "source_id",
        "order_id",
        "locator",
        "extracted_value",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "subject_type": {
          "enum": [
            "claim",
            "evidence",
            "legal_event",
            "inventory",
            "group"
          ]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "extractor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "auditor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "extracted_on": {
          "type": "string",
          "format": "date"
        },
        "audited_on": {
          "type": "string",
          "format": "date"
        },
        "outcome": {
          "enum": [
            "agreed",
            "corrected",
            "unresolved",
            "invalid",
            "not_applicable"
          ]
        },
        "value_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "extractor_id",
